<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Parent of the sibling clones. The SONG88_WORKSPACE environment variable overrides it. -->
    <Song88Workspace Condition="'$(SONG88_WORKSPACE)' != ''">$(SONG88_WORKSPACE)/</Song88Workspace>
    <Song88Workspace Condition="'$(SONG88_WORKSPACE)' == ''">$(MSBuildThisFileDirectory)../../../</Song88Workspace>
    <OddsEngineSrc>$(Song88Workspace)odds-engine-2/src/OddsEngine/</OddsEngineSrc>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <!-- Approved 2026-10-14 for the Mongo-backed publish paths. Same version as
         platform-final's Testcontainers.MsSql (DEVOPS-408). -->
    <PackageReference Include="Testcontainers.MongoDb" Version="4.15.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Contracts.Harness\Contracts.Harness.csproj" />
    <ProjectReference Include="$(OddsEngineSrc)OE.Sportsbook.Service/OE.Sportsbook.Service.csproj" />
    <!-- FakeMessageBroker and FakeMemCache, the fakes OE's own tests use. -->
    <ProjectReference Include="$(OddsEngineSrc)OE.Shared.Test/OE.Shared.Test.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
