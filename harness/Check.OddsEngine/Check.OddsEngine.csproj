<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Parent of the sibling clones. The SONG88_WORKSPACE environment variable overrides it. -->
    <Song88Workspace Condition="'$(SONG88_WORKSPACE)' != ''">$(SONG88_WORKSPACE)/</Song88Workspace>
    <Song88Workspace Condition="'$(SONG88_WORKSPACE)' == ''">$(MSBuildThisFileDirectory)../../../</Song88Workspace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Contracts.Harness\Contracts.Harness.csproj" />
    <ProjectReference Include="$(Song88Workspace)odds-engine-2/src/OddsEngine/OE.Shared/OE.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
